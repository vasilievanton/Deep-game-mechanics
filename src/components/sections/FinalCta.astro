---
import { finalCta } from '@/data/landing';
import { ArrowIcon } from '@/components/ui/ArrowIcon';

interface Props {
  /** Куда ведёт «Собрать пример проекта»: на главной — якорь, на других страницах — `/#configurator`. */
  configuratorHref?: string;
}

const { configuratorHref = '#configurator' } = Astro.props;
---

<section
  class="final-cta section-shell"
  id="contact"
  aria-labelledby="final-cta-heading"
>
  <div class="final-cta__inner" data-reveal>
    <div class="final-cta__art" aria-hidden="true">
      {['quiz', 'trophy', 'gift'].map((name) => (
        <span class={`sticker sticker--${name}`}>
          <img
            src={`/images/mechanics/${name}-sharp.webp`}
            alt=""
            width="256"
            height="256"
            loading="lazy"
            decoding="async"
          />
        </span>
      ))}
    </div>
    <h2 id="final-cta-heading">
      {finalCta.title} <span>{finalCta.accent}</span>
    </h2>
    <p>{finalCta.text}</p>
    <div class="final-cta__actions">
      <a class="arrow-button" href={configuratorHref} data-open-contact>
        <span>{finalCta.primary}</span>
        <span aria-hidden="true" class="arrow-button__icon">
          <ArrowIcon className="arrow-button__arrow" />
        </span>
      </a>
      <a class="final-cta__ghost" href={configuratorHref}>
        {finalCta.secondary}
      </a>
    </div>
  </div>
</section>
